# ============================================================
# ARIA Environment Configuration
# ============================================================

# ── LLM Configuration (Set at least ONE of these) ───────────
# 1. GitHub Models (Free access with a GitHub Personal Access Token)
# Create a classic PAT with no special scopes at: https://github.com/settings/tokens
GITHUB_TOKEN=

# 2. Google Gemini (Get free key from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenAI (Get key from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Database (Optional) ─────────────────────────────────────
# MongoDB Atlas Connection URI.
# If left empty, ARIA automatically stores user profiles locally
# as JSON files in the 'profiles/' folder.
MONGO_URI=

# ── Google Workspace API (Optional) ─────────────────────────
# File path for cached OAuth tokens (default: token.json)
TOKEN_PATH=token.json

# ── Frontend API Host (Optional) ────────────────────────────
API_URL=http://localhost:8001
